rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBannedUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && ('isBanned' in get(/databases/$(database)/documents/users/$(uid)).data)
        && get(/databases/$(database)/documents/users/$(uid)).data.isBanned == true;
    }

    function has(perm) {
      return isSignedIn()
        && !isBannedUser(request.auth.uid)
        && (
          request.auth.token.email == 'maiconhansen3@gmail.com'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && ('effectivePermissions' in me())
            && (perm in me().effectivePermissions)
            && me().effectivePermissions[perm] == true
          )
        );
    }

    function onlyTouchesProfileFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
        'primaryGroupId', 'secondaryGroupIds', 'isStaff',
        'effectivePermissions', 'isBanned', 'bannedAt', 'bannedBy',
        'attributes'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
                  || has('manageUsers')
                  || !('visibility' in resource.data)
                  || resource.data.visibility == 'public';

      allow create: if isOwner(userId) && !isBannedUser(userId);

      allow update: if (
        isOwner(userId)
        && !isBannedUser(userId)
        && onlyTouchesProfileFields()
      ) || has('manageUsers');

      allow delete: if has('manageUsers');
    }

    match /groups/{groupId} {
      allow read: if true;
      allow write: if has('manageGroups');
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /userBadges/{docId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /icons/{iconId} {
      allow read: if true;
      allow create: if has('manageBadges');
      allow update: if has('manageBadges');
      allow delete: if has('manageBadges');
    }

    match /titles/{titleId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /userTitles/{docId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /userCollectibles/{docId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /rarities/{rarityId} {
      allow read: if true;
      allow write: if has('manageCatalogs');
    }

    match /catalogCategories/{categoryId} {
      allow read: if true;
      allow write: if has('manageCatalogs');
    }

    match /origins/{originId} {
      allow read: if true;
      allow write: if has('manageCatalogs');
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if has('manageCatalogs');
    }

    match /forums/{forumId} {
      allow read: if true;
      allow write: if has('manageForum');
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBannedUser(request.auth.uid) && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && !isBannedUser(request.auth.uid) && (resource.data.authorId == request.auth.uid || has('manageForum'));
      allow delete: if has('manageForum');

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && !isBannedUser(request.auth.uid) && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() && !isBannedUser(request.auth.uid) && (resource.data.authorId == request.auth.uid || has('manageForum'));
        allow delete: if has('manageForum');
      }

      match /revisions/{revisionId} {
        allow read: if isSignedIn() && !isBannedUser(request.auth.uid)
                    && (get(/databases/$(database)/documents/threads/$(threadId)).data.authorId == request.auth.uid || has('manageForum'));
        allow create: if isSignedIn() && !isBannedUser(request.auth.uid)
                    && (request.resource.data.editedBy == request.auth.uid || has('manageForum'));
        allow update, delete: if false;
      }
    }

    match /forumReactions/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && !isBannedUser(request.auth.uid) && docId.matches('^' + request.auth.uid + '_.*');
    }

    match /forumReports/{reportId} {
      allow read: if has('manageForum');
      allow create: if isSignedIn() && !isBannedUser(request.auth.uid) && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if has('manageForum');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
