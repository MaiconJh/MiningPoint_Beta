rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBannedUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && ('isBanned' in get(/databases/$(database)/documents/users/$(uid)).data)
        && get(/databases/$(database)/documents/users/$(uid)).data.isBanned == true;
    }

    function has(perm) {
      return isSignedIn()
        && !isBannedUser(request.auth.uid)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ('effectivePermissions' in me())
        && (perm in me().effectivePermissions)
        && me().effectivePermissions[perm] == true;
    }

    function onlyTouchesProfileFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
        'primaryGroupId', 'secondaryGroupIds', 'isStaff',
        'effectivePermissions', 'isBanned', 'bannedAt', 'bannedBy',
        'attributes'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
                  || has('manageUsers')
                  || !('visibility' in resource.data)
                  || resource.data.visibility == 'public';

      allow create: if isOwner(userId) && !isBannedUser(userId);

      allow update: if (
        isOwner(userId)
        && !isBannedUser(userId)
        && onlyTouchesProfileFields()
      ) || has('manageUsers');

      allow delete: if has('manageUsers');
    }

    match /groups/{groupId} {
      allow read: if true;
      allow write: if has('manageGroups');
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /userBadges/{docId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /icons/{iconId} {
      allow read: if true;
      allow create: if has('manageBadges');
      allow update: if has('manageBadges');
      allow delete: if has('manageBadges');
    }

    match /titles/{titleId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /userTitles/{docId} {
      allow read: if true;
      allow write: if has('manageBadges');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
