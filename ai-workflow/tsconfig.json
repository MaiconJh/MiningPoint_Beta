{
"compilerOptions": {
"target": "ES2022",
"module": "ESNext",
"moduleResolution": "bundler",
"lib": ["ES2022"],
"outDir": "dist",
"rootDir": ".",
"strict": true,
"esModuleInterop": true,
"skipLibCheck": true,
"forceConsistentCasingInFileNames": true,
"resolveJsonModule": true,
"declaration": true,
"sourceMap": true,
"noEmit": false,
"isolatedModules": true,
"types": ["node"]
},
"include": ["src/**/*.ts", "scripts/**/*.ts"],
"exclude": ["node_modules", "dist"]
}